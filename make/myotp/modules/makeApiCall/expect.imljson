[
  {
    "name": "url",
    "type": "text",
    "label": "URL",
    "help": "Enter a path relative to `https://api.myotp.app`, starting with `/`. For example: `/report`. A full URL is not accepted: any scheme and host are stripped and the request always goes to api.myotp.app.",
    "required": true,
    "validate": {
      "pattern": "^/",
      "message": "Enter a path starting with /, relative to https://api.myotp.app"
    }
  },
  {
    "name": "method",
    "type": "select",
    "label": "Method",
    "default": "POST",
    "required": true,
    "options": [
      { "label": "GET", "value": "GET" },
      { "label": "POST", "value": "POST" }
    ]
  },
  {
    "name": "headers",
    "type": "array",
    "label": "Headers",
    "help": "Merged with the connection headers. You do not have to add X-API-Key; the connection adds it for you.",
    "default": [
      { "key": "Content-Type", "value": "application/json" }
    ],
    "spec": [
      { "name": "key", "type": "text", "label": "Key" },
      { "name": "value", "type": "text", "label": "Value" }
    ]
  },
  {
    "name": "qs",
    "type": "array",
    "label": "Query String",
    "spec": [
      { "name": "key", "type": "text", "label": "Key" },
      { "name": "value", "type": "text", "label": "Value" }
    ]
  },
  {
    "name": "body",
    "type": "any",
    "label": "Body"
  }
]
