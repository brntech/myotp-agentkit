[
  {
    "name": "phone_number",
    "type": "text",
    "label": "Phone number",
    "help": "Digits only, country code first, no plus sign and no leading zero. Example: 14155550123.",
    "required": true,
    "validate": {
      "pattern": "^[1-9][0-9]{6,14}$"
    }
  },
  {
    "name": "channel",
    "type": "select",
    "label": "Channel",
    "default": "sms",
    "options": [
      { "label": "SMS", "value": "sms" },
      { "label": "WhatsApp", "value": "whatsapp" },
      { "label": "Telegram", "value": "telegram" }
    ]
  },
  {
    "name": "otp_length",
    "type": "uinteger",
    "label": "OTP length",
    "help": "3 to 8 digits (4 to 8 on Telegram). Defaults to 6. Business and Enterprise plans and the free trial.",
    "advanced": true,
    "validate": { "min": 3, "max": 8 }
  },
  {
    "name": "otp_validity",
    "type": "uinteger",
    "label": "Validity (seconds)",
    "help": "30 to 14400 seconds (up to 3600 on Telegram). Defaults to 300. On WhatsApp the template's expiry applies instead. Business and Enterprise plans and the free trial.",
    "advanced": true,
    "validate": { "min": 30, "max": 14400 }
  },
  {
    "name": "template_order",
    "type": "uinteger",
    "label": "Template",
    "help": "Which message template to use. Defaults to 1 (12 for WhatsApp: 12 English 5 minutes, 13 English 10 minutes, 14 Spanish 5 minutes, 15 Spanish 10 minutes).",
    "advanced": true,
    "validate": { "min": 1, "max": 99 }
  },
  {
    "name": "brand",
    "type": "text",
    "label": "Brand",
    "help": "3 to 16 letters, digits or dots. Overrides the account and app defaults. Screened against a denylist.",
    "advanced": true,
    "validate": {
      "pattern": "^[a-zA-Z0-9.]{3,16}$"
    }
  },
  {
    "name": "force_send",
    "type": "boolean",
    "label": "Force send",
    "help": "Send even if an unexpired OTP already exists for this number.",
    "advanced": true
  },
  {
    "name": "return_otp",
    "type": "boolean",
    "label": "Return the OTP in the output",
    "help": "Not compliant with regulations in many markets. Leave off in production.",
    "advanced": true
  }
]
