{
  "baseUrl": "https://api.myotp.app",
  "headers": {
    "X-API-Key": "{{connection.apiKey}}",
    "Content-Type": "application/json"
  },
  "response": {
    "error": {
      "type": "RuntimeError",
      "message": "[{{statusCode}}] {{ifempty(body.error.message, ifempty(body.detail.message, ifempty(body.detail, body.message)))}}",
      "400": {
        "type": "DataError",
        "message": "[400] {{ifempty(body.error.message, ifempty(body.detail.message, body.message))}}"
      },
      "401": {
        "type": "InvalidAccessTokenError",
        "message": "[401] {{ifempty(body.error.message, ifempty(body.detail.message, 'Missing or invalid API key'))}}"
      },
      "402": {
        "type": "DataError",
        "message": "[402] {{ifempty(body.detail, ifempty(body.error.message, 'Payment required. Top up at https://myotp.app'))}}"
      },
      "403": {
        "type": "InvalidConfigurationError",
        "message": "[403] {{ifempty(body.error.message, ifempty(body.detail.message, 'Forbidden. Check the IP allowlist on this API key and the account status'))}}"
      },
      "404": {
        "type": "DataError",
        "message": "[404] {{ifempty(body.error.message, ifempty(body.detail.message, 'Not found'))}}"
      },
      "409": {
        "type": "DataError",
        "message": "[409] {{ifempty(body.error.message, ifempty(body.detail.message, 'Conflict'))}}"
      },
      "429": {
        "type": "RateLimitError",
        "message": "[429] {{ifempty(body.error.message, ifempty(body.detail.message, 'Rate limit exceeded'))}}"
      },
      "500": {
        "type": "ConnectionError",
        "message": "[500] {{ifempty(body.error.message, ifempty(body.detail.message, 'Internal Server Error'))}}"
      }
    }
  },
  "log": {
    "sanitize": [
      "request.headers.x-api-key",
      "response.body.otp"
    ]
  }
}
