[
  {
    "name": "message_id",
    "type": "text",
    "label": "Message ID",
    "help": "The message_id returned by Send OTP.",
    "required": true
  },
  {
    "name": "duration",
    "type": "uinteger",
    "label": "Extend by (seconds)",
    "help": "60 to 14400 seconds.",
    "required": true,
    "default": 300,
    "validate": { "min": 60, "max": 14400 }
  }
]
