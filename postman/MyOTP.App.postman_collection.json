{
  "info": {
    "name": "MyOTP.App",
    "description": "Send and verify one-time passcodes over SMS, WhatsApp and Telegram from a single API key. Phone numbers are digits only, in E.164 order, with no leading '+' and no trailing national prefix.\n\nDelivery webhooks: register a callback URL against an API key in your dashboard and MyOTP will POST to it when a message reaches a terminal state, so you do not have to poll /check_otp_status. Events are otp.delivered, otp.sent, otp.read and otp.failed, on all three channels. The body is the DeliveryEvent schema below. Every request is signed with Standard Webhooks v1 (standardwebhooks.com), so you can verify it with any off-the-shelf library: the signed content is \"{webhook-id}.{webhook-timestamp}.{body}\", HMAC-SHA256 with your base64-decoded signing secret, sent in the webhook-signature header as \"v1,<base64>\". Non-2xx responses are retried 5 times at 5, 10, 20, 40 and 60 seconds. Endpoints must be https.\n\nGenerated from openapi-reference.yaml (API 1.4.0).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "X-API-Key",
        "type": "string"
      },
      {
        "key": "value",
        "value": "{{api_key}}",
        "type": "string"
      },
      {
        "key": "in",
        "value": "header",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://api.myotp.app",
      "type": "string"
    },
    {
      "key": "api_key",
      "value": "",
      "type": "string"
    },
    {
      "key": "phone_number",
      "value": "19876543210",
      "type": "string"
    },
    {
      "key": "message_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "otp",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Generate OTP",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is one of 200\", () => pm.expect(pm.response.code).to.be.oneOf([200]));",
              "pm.test(\"response is JSON\", () => pm.response.to.be.json);",
              "const json = pm.response.json();",
              "pm.test(\"message_id present\", () => pm.expect(json.message_id).to.be.a(\"string\"));",
              "// Verify OTP, Extend OTP and Check OTP Status read this collection variable.",
              "pm.collectionVariables.set(\"message_id\", json.message_id);",
              "// Only present when the request asked for return_otp: true.",
              "if (json.otp) pm.collectionVariables.set(\"otp\", json.otp);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/generate_otp",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "generate_otp"
          ]
        },
        "description": "Generate a One Time Password (OTP) and send it to the specified phone number, with optional branding.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phone_number\": \"{{phone_number}}\",\n  \"otp_length\": 6,\n  \"otp_validity\": 300,\n  \"channel\": \"sms\",\n  \"template_order\": 1,\n  \"brand\": \"MyOTP.App\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "Verify OTP",
      "event": [
