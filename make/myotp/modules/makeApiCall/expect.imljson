[
  {
    "name": "url",
    "type": "text",
    "label": "URL",
    "help": "Enter a path relative to `https://api.myotp.app`. For example: `/report`",
    "required": true
  },
  {
    "name": "method",
    "type": "select",
    "label": "Method",
    "default": "POST",
    "required": true,
    "options": [
      { "label": "GET", "value": "GET" },
      { "label": "POST", "value": "POST" }
    ]
  },
  {
    "name": "headers",
    "type": "array",
    "label": "Headers",
    "help": "You do not have to add the X-API-Key header; the connection adds it for you.",
    "default": [
      { "key": "Content-Type", "value": "application/json" }
    ],
    "spec": [
      { "name": "key", "type": "text", "label": "Key" },
      { "name": "value", "type": "text", "label": "Value" }
    ]
  },
  {
    "name": "qs",
    "type": "array",
    "label": "Query String",
    "spec": [
      { "name": "key", "type": "text", "label": "Key" },
      { "name": "value", "type": "text", "label": "Value" }
    ]
  },
  {
    "name": "body",
    "type": "any",
    "label": "Body"
  }
]
